#!/usr/bin/env bash
# herdr-remote: CLI management tool for Herdr Remote WebSocket Bridge & Android Workspace Sync
set -eo pipefail

BRIDGE_SCRIPT="/Users/chetan/Desktop/Chetan/projects/herdr-remote-android/herdr-bridge.py"
LOG_FILE="/tmp/herdr-bridge.log"
PLIST_PATH="$HOME/Library/LaunchAgents/com.herdr.remote.bridge.plist"
PORT=8765

is_running() {
    pgrep -f "herdr-bridge.py" > /dev/null 2>&1
}

cmd_status() {
    if is_running; then
        local pid
        pid=$(pgrep -f "herdr-bridge.py" | head -n 1)
        echo "🟢 Herdr Remote Bridge is RUNNING (PID: $pid) on port $PORT"
        echo "   WebSocket URL: ws://0.0.0.0:$PORT"
        echo "   Herdr Socket:  $HOME/.config/herdr/herdr.sock"
        if lsof -i :$PORT > /dev/null 2>&1; then
            echo "   Port status:   Active and listening"
        fi
    else
        echo "🔴 Herdr Remote Bridge is STOPPED."
    fi
}

cmd_start() {
    if is_running; then
        echo "⚠️  Herdr Remote Bridge is already running (PID: $(pgrep -f "herdr-bridge.py" | head -n 1))."
        cmd_status
        return 0
    fi

    echo "🚀 Starting Herdr Remote Bridge on ws://0.0.0.0:$PORT..."
    nohup python3 "$BRIDGE_SCRIPT" > "$LOG_FILE" 2>&1 &
    sleep 0.8

    if is_running; then
        echo "✅ Started successfully (PID: $(pgrep -f "herdr-bridge.py" | head -n 1))."
        echo "   Logs: $LOG_FILE"
    else
        echo "❌ Failed to start. Showing last log lines:"
        tail -n 20 "$LOG_FILE"
        return 1
    fi
}

cmd_stop() {
    if ! is_running; then
        echo "⚠️  Herdr Remote Bridge is not running."
        return 0
    fi

    echo "🛑 Stopping Herdr Remote Bridge..."
    pkill -f "herdr-bridge.py" || true
    sleep 0.5
    if ! is_running; then
        echo "✅ Herdr Remote Bridge stopped."
    else
        echo "⚠️  Force killing..."
        pkill -9 -f "herdr-bridge.py" || true
        echo "✅ Stopped."
    fi
}

cmd_restart() {
    cmd_stop
    sleep 0.5
    cmd_start
}

cmd_logs() {
    if [[ ! -f "$LOG_FILE" ]]; then
        touch "$LOG_FILE"
    fi
    echo "📋 Tailing $LOG_FILE (Ctrl+C to exit)..."
    tail -f "$LOG_FILE"
}

cmd_foreground() {
    cmd_stop || true
    echo "🚀 Running Herdr Remote Bridge in foreground on 0.0.0.0:$PORT..."
    exec python3 "$BRIDGE_SCRIPT"
}

cmd_install_service() {
    mkdir -p "$HOME/Library/LaunchAgents"
    cat << PLIST_EOF > "$PLIST_PATH"
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.herdr.remote.bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>$BRIDGE_SCRIPT</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOG_FILE</string>
    <key>StandardErrorPath</key>
    <string>$LOG_FILE</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/Users/chetan/.local/bin</string>
        <key>HOME</key>
        <string>$HOME</string>
    </dict>
</dict>
</plist>
PLIST_EOF

    launchctl unload "$PLIST_PATH" 2>/dev/null || true
    launchctl load "$PLIST_PATH"
    echo "✅ Installed and started macOS background service: $PLIST_PATH"
}

cmd_uninstall_service() {
    if [[ -f "$PLIST_PATH" ]]; then
        launchctl unload "$PLIST_PATH" 2>/dev/null || true
        rm -f "$PLIST_PATH"
        echo "✅ Removed LaunchAgent service: $PLIST_PATH"
    else
        echo "Service is not installed."
    fi
}

case "${1:-start}" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    status)
        cmd_status
        ;;
    log|logs)
        cmd_logs
        ;;
    run|fg|foreground)
        cmd_foreground
        ;;
    install-service)
        cmd_install_service
        ;;
    uninstall-service)
        cmd_uninstall_service
        ;;
    help|--help|-h)
        echo "Usage: herdr-remote [start|stop|restart|status|logs|foreground|install-service|uninstall-service]"
        echo ""
        echo "Commands:"
        echo "  start             Start Herdr Remote WebSocket daemon in background"
        echo "  stop              Stop running daemon"
        echo "  restart           Restart daemon"
        echo "  status            Check daemon status and port"
        echo "  logs              Tail daemon output logs"
        echo "  foreground        Run daemon interactively in foreground"
        echo "  install-service   Install macOS LaunchAgent to auto-start on login"
        echo "  uninstall-service Remove macOS LaunchAgent"
        ;;
    *)
        echo "Unknown command: $1"
        echo "Run 'herdr-remote help' for usage."
        exit 1
        ;;
esac
